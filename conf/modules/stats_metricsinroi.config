/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*ATLAS_IIT:THR_BUNDLE_MASK' {
        ext.prefix = { "${meta.id}" }
        memory        = 1.GB
        time          = 20.M
    }

    withName: '.*ATLAS_IIT:SMOOTH_MASK' {
        memory        = 1.GB
        time          = 20.M
    }

    withName: '.*ATLAS_IIT:THR_SMOOTHED_MASK' {
        memory        = 1.GB
        time          = 20.M
    }

    withName: ".*:STATS_WM_ROIMETRICS" {
        ext.key_substrs_to_remove = {["${task.ext.prefix}_", "_mask_warped", "_warped"]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__", "${task.ext.prefix}_desc-fwc__"]}
        ext.meta_columns = params.tractometry_covariates.split(",")
        ext.normalize_weights = !params.use_binary_masks
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains(".csv") ) { "${prefix}_atlas-iit-wm_desc-roi_stats.csv" }
                else if ( filename.contains(".tsv") ) { "${prefix}_atlas-iit-wm_desc-roi_stats.tsv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_WM_VOLUMES" {
        ext.prefix = { meta.id }
        ext.key_substrs_to_remove = {["${task.ext.prefix}_", meta.session ? "${meta.session}_" : null, "_mask_warped", "_warped"].findAll()}
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith(".csv") ) { "${prefix}_atlas-iit-wm_desc-roi_volumes.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { null }
            }
        ]
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_GM_VOLUMES" {
        ext.use_label = true
        ext.first_suffix = "atlas-iit-gm"
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith(".csv") ) { "${prefix}_atlas-iit-gm_desc-roi_volumes.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { null }
            }
        ]
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_GM_ROIMETRICS" {
        ext.use_label = true
        ext.first_suffix = "atlas-iit-gm"
        ext.normalize_weights = false
        ext.key_substrs_to_remove = {["${task.ext.prefix}__"]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__", "${task.ext.prefix}_desc-fwc__"]}
        ext.meta_columns = params.tractometry_covariates.split(",")
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains(".csv") ) { "${prefix}_atlas-iit-gm_desc-roi_stats.csv" }
                else if ( filename.contains(".tsv") ) { "${prefix}_atlas-iit-gm_desc-roi_stats.tsv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}

includeConfig '../../subworkflows/nf-neuro/atlas_roimetrics/nextflow.config'

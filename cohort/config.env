# Site settings, read by run.sh and every job script. Nothing the pipeline computes is set here:
# parameters are in params/, how tasks run in configs/<machine>.config.

# Name of this cohort run: its Slurm job names (sft-<name>) and task tags. Unique per checkout on a
# cluster, so two cohorts never take each other's jobs for their own.
COHORT_NAME="adni"

# Machine: vitaltour (local executor, Docker) or an Alliance cluster (Slurm, Apptainer). Alliance
# sets CC_CLUSTER (rorqual, fir, ...); anywhere else this is vitalTour.
MACHINE="${CC_CLUSTER:-vitaltour}"

# Batch mode. false (default): one folder, one work/, nothing packed, as on vitalTour. true: the
# subjects are split into batches/bNNNN/, each run by its own Slurm job that unpacks the batch,
# runs the pass and packs it back into one archive file (scratch inode quota). Overridden for one
# call by ./run.sh --batch / --no-batch.
BATCH=false
BATCH_SIZE=10        # sessions per batch (a subject is never split between batches)
MAX_UNPACKED=10      # batches running (so unpacked) at once: free inodes / inodes of one batch
# Results copied out of each packed batch into batches/bNNNN/extracted_results.tar.gz (one file,
# rebuilt at every pack; the full out/ is in archives/bNNNN.tar). Globs relative to out/, ** for any
# depth: the cohort tables and the global MultiQC report by default. Per-session files can be added,
# e.g. "**/*_desc-thickness.csv" or "sub-*/ses-*/anat/*_seg-reconall_desc-hippoamyg_volumes.csv".
# ./run.sh merge reads the tables from these files.
EXTRACT_PATTERNS="metrics/** multiqc/*.html"

# Slurm account of every job (Alliance only): the def-pmjodoin CPU allocation (rrg-descotea is GPU
# only). `sacctmgr -nP show assoc user=$USER format=account` lists yours.
ACCOUNT="def-pmjodoin_cpu"

# The pipeline is the sf-tractomics checkout this folder (cohort/) sits in: clone the fork, check out
# its branch (samseg-fc-runs), and run from cohort/. Each launch folder pins the pipeline version
# of its first pass (scripts/lib.sh), so pulling new pipeline commits is refused mid-cohort.

# Nextflow, as on vitalTour (the version every check ran with)
NXF_VER="26.04.4"

# Input: the sessions listed in inputs/participants.tsv, read from a BIDS folder. On Rorqual, the
# ADNI folder of the project space; on Fir (no ADNI), inputs_transfer/ADNI_BIDS, filled beforehand;
# on vitalTour, the ADNI test's copy. In batch mode a batch copies only its own subjects, when it
# first runs, and packs them with its work.
case "$MACHINE" in
    rorqual)   INPUT_BIDS="/home/pierrard/links/projects/rrg-descotea/vitalab/davy3002/ADNI_BIDS/bids" ;;
    vitaltour) INPUT_BIDS="/home/local/USHERBROOKE/pieb8959/Documents/sf_tractomics_volume/test_adni_volumes/data_bids" ;;
    *)         INPUT_BIDS="${PWD}/inputs_transfer/ADNI_BIDS" ;;
esac

# Finished archives (a batch done with every pass of params/passes/) leave scratch for this folder:
# scratch is purged and quota-bound, project space is neither. Empty: they stay in archives/. A later
# pass unpacks from here directly. Rorqual: the lab's project space. One subfolder per COHORT_NAME:
# batch names restart at b0001 in every cohort, and a batch with no archive on scratch is unpacked
# from the store, so a shared folder would hand a new cohort's b0001 the archive of another one.
case "$MACHINE" in
    rorqual) ARCHIVE_STORE="${ARCHIVE_STORE:-/project/rrg-descotea/vitalab/pierrard/adni/finished_archives/$COHORT_NAME}" ;;
    *)       ARCHIVE_STORE="${ARCHIVE_STORE:-}" ;;
esac

# Internet on the compute nodes. Rorqual's have none: setup then downloads nothing. It checks that
# bin/, .nextflow_home/, containers/, .atlas_cache/ and work/atlas_iit/ were copied into this folder
# from one where setup ran (e.g. Fir, by Globus), and every Nextflow run is offline (NXF_OFFLINE).
case "$MACHINE" in
    rorqual) OFFLINE="${OFFLINE:-true}" ;;
    *)       OFFLINE="${OFFLINE:-false}" ;;
esac

# FreeSurfer licence (recon-all, subfields, CSF atlas extraction), next to this file, out of git
FS_LICENSE="${PWD}/license_freesurfer.txt"

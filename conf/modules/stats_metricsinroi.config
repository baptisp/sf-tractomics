/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*ATLAS_IIT:THR_BUNDLE_MASK' {
        ext.prefix = { "${meta.id}" }
        memory        = 1.GB
        time          = 20.M
    }

    withName: '.*ATLAS_IIT:SMOOTH_MASK' {
        memory        = 1.GB
        time          = 20.M
    }

    withName: '.*ATLAS_IIT:THR_SMOOTHED_MASK' {
        memory        = 1.GB
        time          = 20.M
    }

    withName: ".*:ATLAS_ROIMETRICS:REGISTER_IIT_REF" {
        // One thread: antsRegistrationSyN.sh on several threads gives a different warp on every run,
        // even with the fixed seed (6 threads, two runs on the same b0 on Fir: displacement differs
        // by 0.018 mm median, 2.2 mm max, atlas volumes by up to 2.9 %). On one thread the warp is
        // bit-identical across runs. About 9 min per ADNI b0 on Fir.
        cpus = 1
        ext.single_thread = true
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_MASK_METRICS" {
        ext.key_substrs_to_remove = {["${task.ext.prefix}_", "_mask_warped", "_warped"]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__"]}
        ext.meta_columns = { params.tractometry_covariates.split(",") }
        ext.normalize_weights = { !params.use_binary_masks }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                // Mean and std tables share the extension: the std gets its own name, or one
                // would overwrite the other in the published folder
                if ( filename.contains("_desc-std_") ) { "${prefix}_atlas-iit-wm_label-std_desc-roi_stats.${filename.tokenize('.').last()}" }
                else if ( filename.contains(".csv") ) { "${prefix}_atlas-iit-wm_desc-roi_stats.csv" }
                else if ( filename.contains(".tsv") ) { "${prefix}_atlas-iit-wm_desc-roi_stats.tsv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_MASK_VOLUMES" {
        // Binary bundle masks are warped with linear interpolation: count their border voxels by
        // their covered fraction, not as whole voxels (+40 to +125% on IIT bundles otherwise).
        // Soft track-density maps (use_binary_masks = false) keep the non-zero voxel count.
        ext.mask_volume = { params.use_binary_masks ? "fraction" : "nonzero" }
        ext.prefix = { meta.id }
        // The mask names start with the subject, session and run: all three are removed, or a run
        // with a run number keeps "run-1_" in front of every bundle name, and its volumes then join
        // no stats row (bundle volumes empty in the stats and combined tables of multi-run sessions)
        ext.key_substrs_to_remove = {["${task.ext.prefix}_", meta.session ? "${meta.session}_" : null, meta.run ? "${meta.run}_" : null, "_mask_warped", "_warped"].findAll()}
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith(".csv") ) { "${prefix}_atlas-iit-wm_desc-roi_volumes.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { null }
            }
        ]
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_LABELMAP_VOLUMES" {
        ext.use_label = true
        ext.first_suffix = "atlas-iit-gm"
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith(".csv") ) { "${prefix}_atlas-iit-gm_desc-roi_volumes.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { null }
            }
        ]
    }

    withName: ".*:ATLAS_ROIMETRICS:STATS_LABELMAP_METRICS" {
        ext.use_label = true
        ext.first_suffix = "atlas-iit-gm"
        ext.normalize_weights = false
        ext.key_substrs_to_remove = {[]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__"]}
        ext.meta_columns = { params.tractometry_covariates.split(",") }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                // Mean and std tables share the extension: the std gets its own name, or one
                // would overwrite the other in the published folder
                if ( filename.contains("_desc-std_") ) { "${prefix}_atlas-iit-gm_label-std_desc-roi_stats.${filename.tokenize('.').last()}" }
                else if ( filename.contains(".csv") ) { "${prefix}_atlas-iit-gm_desc-roi_stats.csv" }
                else if ( filename.contains(".tsv") ) { "${prefix}_atlas-iit-gm_desc-roi_stats.tsv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}

includeConfig '../../subworkflows/nf-neuro/atlas_roimetrics/nextflow.config'

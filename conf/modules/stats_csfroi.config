/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config for CSF region ROI metrics and volumes (FreeSurfer MNI152 parcellation)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: ".*:ATLAS_CSF_ROIMETRICS:STATS_CSF_ROIMETRICS" {
        ext.use_label            = true
        ext.first_suffix         = "atlas-freesurfer-csf"
        ext.normalize_weights    = false
        ext.key_substrs_to_remove   = {[]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__"]}
        ext.meta_columns         = params.tractometry_covariates.split(",")
        publishDir = [
            path: { meta.session
                ? "${params.outdir}/${meta.id}/${meta.session}/dwi/"
                : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains(".tsv") ) { "${prefix}_atlas-freesurfer-csf_desc-roi_stats.tsv" }
                else if ( filename.contains(".csv") ) { "${prefix}_atlas-freesurfer-csf_desc-roi_stats.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:ATLAS_CSF_ROIMETRICS:STATS_CSF_VOLUMES" {
        ext.use_label            = true
        ext.first_suffix         = "atlas-freesurfer-csf"
        publishDir = [
            path: { meta.session
                ? "${params.outdir}/${meta.id}/${meta.session}/dwi/"
                : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith(".csv") ) { "${prefix}_atlas-freesurfer-csf_desc-roi_volumes.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { null }
            }
        ]
    }

    withName: ".*:ATLAS_CSF_ROIMETRICS:STATS_CSF_COMPARISON" {
        ext.use_label            = true
        ext.first_suffix         = "atlas-freesurfer-comparison"
        ext.normalize_weights    = false
        ext.key_substrs_to_remove   = {[]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__"]}
        ext.meta_columns         = params.tractometry_covariates.split(",")
        publishDir = [
            path: { meta.session
                ? "${params.outdir}/${meta.id}/${meta.session}/dwi/comparison/"
                : "${params.outdir}/${meta.id}/dwi/comparison/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains(".tsv") ) { "${prefix}_atlas-freesurfer-comparison_desc-roi_stats.tsv" }
                else if ( filename.contains(".csv") ) { "${prefix}_atlas-freesurfer-comparison_desc-roi_stats.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:ATLAS_CSF_ROIMETRICS:STATS_CSF_COMPARISON_VOLUMES" {
        ext.use_label            = true
        ext.first_suffix         = "atlas-freesurfer-comparison"
        publishDir = [
            path: { meta.session
                ? "${params.outdir}/${meta.id}/${meta.session}/dwi/comparison/"
                : "${params.outdir}/${meta.id}/dwi/comparison/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith(".csv") ) { "${prefix}_atlas-freesurfer-comparison_desc-roi_volumes.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { null }
            }
        ]
    }

    withName: ".*:ATLAS_CSF_ROIMETRICS:EXTRACT_FREESURFER_MNI_ATLAS" {
        // Never retry/ignore: a failure here (license, image pull, mri_convert) means
        // the whole CSF pipeline cannot proceed. Override the global errorStrategy so
        // the pipeline terminates immediately with a clear error instead of being silently ignored.
        errorStrategy = 'terminate'
        maxRetries    = 0
    }

    withName: ".*:ATLAS_CSF_ROIMETRICS:REGISTER_CSF_REF" {
        publishDir = [
            path: { meta.session
                ? "${params.outdir}/${meta.id}/${meta.session}/dwi/"
                : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: { params.clean_output ? null : it }
        ]
    }
}

includeConfig '../../subworkflows/nf-neuro/atlas_csf_roimetrics/nextflow.config'

--- upstream 6fcc3344/subworkflows/nf-neuro/atlas_roimetrics/nextflow.config
+++ sf-tractomics/subworkflows/nf-neuro/atlas_roimetrics/nextflow.config
@@ -1 +1,14 @@
+process {
+    withName: '.*ATLAS_ROIMETRICS:TRANSFORM_IIT_GM_ATLAS' {
+        ext.dimensionality = 3
+        ext.image_type     = 0
+        // GenericLabel, not MultiLabel: MultiLabel votes over a smoothed neighbourhood and alters
+        // label volumes even under an identity transform (FreeSurfer atlas: Left-Inf-Lat-Vent 49 -> 14
+        // voxels, 3rd-Ventricle -10%). GenericLabel reproduces the labels exactly. See tests/known_answer.
+        ext.interpolation  = "GenericLabel"
+        ext.output_dtype   = "short"
+        ext.default_val    = 0
+    }
+}
+
 includeConfig '../atlas_iit/nextflow.config'

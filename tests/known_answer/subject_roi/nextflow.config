process {
    // As in conf/base.config: one file name per sample
    ext.prefix = { [meta.id, meta.session ?: "", meta.run ?: ""].findAll { x -> x }.join("_") }
    withName: "STATS_METRICSINROI" {
        ext.key_substrs_to_remove   = { ["${task.ext.prefix}__", "_fraction"] }
        ext.value_substrs_to_remove = { ["${task.ext.prefix}__"] }
    }
}

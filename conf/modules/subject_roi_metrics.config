// Diffusion metrics in the subject's own GM regions (run_subject_roi_metrics). File names carry the
// segmentation: seg-synthseg, seg-freesurfer or seg-samseg (run_longitudinal_volumes).

process {

    withName: ".*:SUBJECT_ROI_FRACTIONS" {
        ext.min_fraction = { params.subject_roi_min_fraction }
        ext.small_region_voxels = { params.subject_roi_small_region_voxels }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                // The fraction maps are intermediate (one per region): only the sums are published
                filename.endsWith("_fraction_sums.csv") ? "${prefix}_seg-${params.run_longitudinal_volumes == true ? "samseg" : params.volume_source}_desc-roi_fractions.csv" : null
            }
        ]
    }

    withName: ".*:STATS_SUBJECT_ROI_METRICS" {
        // Weighted means (weights = voxel fractions); binary masks when subject_roi_min_fraction > 0
        ext.use_label = false
        ext.normalize_weights = false
        ext.first_suffix = { "seg-${params.run_longitudinal_volumes == true ? "samseg" : params.volume_source}" }
        ext.key_substrs_to_remove = { ["${task.ext.prefix}__", "_fraction"] }
        ext.value_substrs_to_remove = { ["${task.ext.prefix}__"] }
        ext.meta_columns = { params.tractometry_covariates.split(",") }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                def seg = params.run_longitudinal_volumes == true ? "samseg" : params.volume_source
                if ( filename.contains("_desc-std_") ) { "${prefix}_seg-${seg}_label-std_desc-roi_stats.${filename.tokenize('.').last()}" }
                else if ( filename.contains("_desc-mean_") ) { "${prefix}_seg-${seg}_desc-roi_stats.${filename.tokenize('.').last()}" }
                else { null }
            }
        ]
    }
}

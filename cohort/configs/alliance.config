// How tasks run on an Alliance cluster (Rorqual, Fir), never what they compute (parameters are in
// params/). Used with -profile apptainer,slurm,iit_tractometry: the pipeline's slurm profile submits
// one Slurm job per task (executor, queue polling, job names, lenient cache, apptainer
// --containall); this file adds the account, the node-local scratch, resource caps and retries.
// Every task runs on CPU: no step of these runs needs a GPU (eddy is eddy_cpu, tracking is off).

process {
    // Slurm account of config.env. The comment tags every task job with its launch folder (root
    // folder, or batch), so packing a batch can wait for, or cancel, the task jobs it left behind.
    clusterOptions = "--account=${System.getenv('SFT_ACCOUNT')} --comment=${System.getenv('SFT_TAG')}"
    // Node-local disk of the job: inputs and intermediate files stay off the shared file system
    scratch        = '$SLURM_TMPDIR'
    beforeScript   = 'module load apptainer'

    // Rorqual and Fir CPU nodes have 192 cores and about 750 GB; one task never needs a whole node.
    // SynthSeg needs about 28 GB; recon-all about 7 h on one T1.
    resourceLimits = [ cpus: 32, memory: 128.GB, time: 48.h ]

    // Out of memory (137), time limit (140, 143), broken pipe (141), unknown error (255) or a task job
    // gone without an exit code (Integer.MAX_VALUE: node failure, a job cancelled by hand; Rorqual,
    // a container hung at start, cancelled): retried up to 3 times with the larger request of the next
    // attempt. Any other failure is left ('ignore'): one session's failure (e.g. an N4 that diverges
    // on one T1) no longer stops the other sessions of its batch; the failed task is listed in
    // out/metrics/failed_tasks.tsv (scripts/failure_report.py). A failure of more than
    // MAX_FAILED_FRACTION of the batch's DWI runs (a bug, not a run) still fails the pass.
    // A task whose job was never submitted (sbatch refused it after the executor's own retries,
    // executor.retry below) is retried too: it carries sbatch's exit code, not one of the list
    // (Rorqual, 2026-11-10 11:04-11:14: a Slurm controller outage left 35 tasks of 5 batches
    // 'ignored' without ever running).
    // 126 too: the task's job could not start its own script (Fir, 2026-11-12, 01:00-09:00 MST: CVMFS
    // gave 'Input/output error' on mktemp on a few nodes, fc30564, fc30649, fc30659; 7 batches had
    // tasks 'ignored' after one attempt). A retry goes back to Slurm, so usually to another node.
    maxRetries    = 3
    errorStrategy = { (task.exitStatus in [126, 137, 140, 141, 143, 255, Integer.MAX_VALUE]
                       || task.previousException?.message?.startsWith('Error submitting process'))
                      && task.attempt <= 3 ? 'retry' : 'ignore' }

    // Statistics tasks take seconds to 12 min (ADNI, Rorqual). A container that hangs at start (seen
    // once on Rorqual: Apptainer waiting, no process, 40 min) then dies at 1 h and is retried, instead
    // of holding its batch to the 4 h default
    withName: '.*:STATS_.*' {
        time = { 1.h * task.attempt }
    }

    // First request of each attempt, from the peaks of the ADNI test batches on Rorqual (3 subjects,
    // 6 sessions: single and multi-shell, with and without field map, DWI resampled to 1 mm) and on
    // Fir (multi-shell): at least 30% above the largest peak, so a session fails for
    // memory only when it is larger than any seen. Peaks: eddy 22.5 GB (12 GB killed), SynthSeg
    // 35.9 GB on a 1.2 mm ADNI2 T1 (32 GB killed), b0 extraction and DWI brain extraction 4.3 GB
    // (4 GB killed), subject-region fractions 5.2 GB (4 GB killed), T1 to DWI registration 3.1 GB,
    // FRF 5.4 GB, DTI 8.3 GB (Fir) and free-water-corrected DTI 7.3 GB, free water 14.1 GB, NODDI
    // 10.2 GB.
    // Requested memory is not part of the task hash: changing it recomputes nothing.
    // Time and the remaining memory requests: from the first ADNI cohort day on Rorqual (2026-11-06,
    // about 10,000 tasks, 12 batches): memory about 1.4x the largest peak, time 2.5 to 4x the longest
    // run (at least 2 h). Both grow with the attempt, so a task that runs out is retried with more.
    // Most tasks fit under 3 h, so they can run on every node and fill scheduling gaps; the requests
    // used to be 4 to 24 h for tasks of minutes. CPUs are left as they are: several modules write the
    // thread count into their script (it is in the task hash), and ANTs results depend on it.
    // Pass-2 metrics are not measured yet and keep their requests.
    withName: '.*:PREPROC_EDDY' {
        memory = { 30.GB * task.attempt }   // peak 21.1 GB
        time   = { 12.h * task.attempt }    // longest 5 h 04
    }
    withName: '.*:SYNTHSEG_VOLUMES' {
        memory = { 48.GB * task.attempt }   // peak 38.7 GB
        time   = { 2.h * task.attempt }     // longest 28 min
    }
    withName: '.*:RECONALL_THICKNESS(_RERUN)?' {
        memory = { 5.GB * task.attempt }    // peak 3.5 GB; 8 GB was billed as two cores
        time   = { 24.h * task.attempt }    // longest 8 h 32 (one thread)
    }
    withName: '.*:BETCROP_ANTSBET' {
        memory = { 6.GB * task.attempt }    // peak 3.8 GB
        time   = { 3.h * task.attempt }     // longest 37 min
    }
    withName: '.*:(PREPROC_T1:PREPROC_N4|N4_DWI)' {
        memory = { 5.GB * task.attempt }    // peak 2.6 GB
        time   = { 2.h * task.attempt }     // longest 11 min
    }
    withName: '.*:RECONST_FODF' {
        memory = { 10.GB * task.attempt }   // peak 7.3 GB
        time   = { 3.h * task.attempt }     // longest 29 min
    }
    withName: '.*:REGISTER_(IIT|CSF)_REF' {
        memory = { 4.GB * task.attempt }    // peak 2.6 GB
        time   = { 2.h * task.attempt }     // longest 24 min (one thread)
    }
    withName: '.*:PREPROC_TOPUP' {
        memory = { 5.GB * task.attempt }    // peak 3.0 GB
        time   = { 3.h * task.attempt }     // longest 43 min
    }
    withName: '.*:SEGMENTATION_HIPPOAMYG' {
        memory = { 4.GB * task.attempt }    // peak 2.8 GB
        time   = { 2.h * task.attempt }     // longest 23 min
    }
    withName: '.*:DENOISING_NLMEANS' {
        memory = { 3.GB * task.attempt }    // peak 2.0 GB
        time   = { 2.h * task.attempt }     // longest 3 min
    }
    withName: '.*:DENOISE_DWI' {
        memory = { 8.GB * task.attempt }    // peak 5.5 GB
        time   = { 2.h * task.attempt }     // longest 16 min
    }
    withName: '.*:RESAMPLE_DWI' {
        memory = { 8.GB * task.attempt }    // peak 5.3 GB
        time   = { 2.h * task.attempt }     // longest 8 min
    }
    withName: '.*:PREPROC_GIBBS_DWI' {
        memory = { 6.GB * task.attempt }    // peak 4.5 GB: 4 GB was killed on first attempts
        time   = { 2.h * task.attempt }     // longest 14 min
    }
    withName: '.*:(SEGMENTATION_FASTSEG|TRANSFORM_IIT_BUNDLES)' {
        memory = { 2.GB * task.attempt }    // peaks 1.0 and 0.7 GB
        time   = { 2.h * task.attempt }     // longest 4 and 21 min
    }
    withName: '.*:NORMALIZE_DWI' {
        memory = { 5.GB * task.attempt }    // peak 3.0 GB
        time   = { 2.h * task.attempt }     // longest 18 min
    }
    withName: '.*:(EXTRACT_B0|UTILS_EXTRACTB0|BETCROP_FSLBETCROP)' {
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }     // longest 14 min (BET), 6 min, 3 min
    }
    // Tasks of seconds to minutes that kept the 4 h default. About 1 task in 500 hangs at container
    // start on Rorqual (Apptainer waiting, no process, 0 CPU, on any node): it is retried only at its
    // time limit, and holds its batch until then.
    withName: '.*:(MULTIQC|MULTIQC_GLOBAL|QC_ATLASREG_.*|SEGMENTATION_RECONALLSEG|RESAMPLE_MASK|IMAGE_CROPVOLUME_.*|IO_READBIDS|TRANSFORM_CSF_ATLAS|EXTRACT_FREESURFER_MNI_ATLAS)' {
        time   = { 1.h * task.attempt }     // longest 6 min (MULTIQC, TRANSFORM_CSF_ATLAS), others under 3 min
    }
    withName: '.*:TRANSFORM_IIT_GM_ATLAS' {
        time   = { 2.h * task.attempt }     // longest 29 min
    }
    withName: '.*:SUBJECT_ROI_FRACTIONS' {
        memory = { 8.GB * task.attempt }
    }
    withName: '.*:REGISTRATION_ANATTODWI' {
        memory = { 5.GB * task.attempt }    // peak 3.5 GB
        time   = { 2.h * task.attempt }     // longest 34 min (one thread)
    }
    withName: '.*:RECONST_FRF' {
        memory = { 8.GB * task.attempt }    // peak 6.8 GB
        time   = { 2.h * task.attempt }     // longest 4 min
    }
    withName: '.*:RECONST_FREEWATER' {
        memory = { 20.GB * task.attempt }
    }
    withName: '.*:RECONST_NODDI' {
        memory = { 14.GB * task.attempt }
    }
    withName: '.*:RECONST_DTIMETRICS' {
        memory = { 12.GB * task.attempt }   // peak 8.9 GB
        time   = { 2.h * task.attempt }     // longest 29 min
    }
    withName: '.*:FW_CORRECTED_DTIMETRICS' {
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

executor {
    // Per Nextflow, so per batch (BATCH_SIZE sessions, about 10 tasks of a session at once at most).
    // Slurm's per-user limit (MaxSubmitJobs: 1000 on Rorqual's def- account) counts every job: the
    // task jobs of every batch, the batch jobs, and each waiting task of the batch array. Past it a
    // submission is refused, and the task fails (then is skipped, errorStrategy above). So
    // MAX_UNPACKED x (queueSize + 1) + the waiting batches must stay under it: 20 here, with 30
    // batches at once and 300 waiting, about 930; with 50 the limit was near at 12 batches.
    queueSize       = 20
    submitRateLimit = '10/1min'
    // A failed sbatch is retried by Nextflow itself when its output matches `reason` (default: only
    // 'Socket timed out'). Controller outages and the per-user job limit are transient: up to 10
    // attempts, 30 s to 5 min apart (about 25 min), before the task fails (errorStrategy above).
    retry {
        reason      = 'Socket timed out|Unable to contact slurm controller|Slurm temporarily unavailable|Transport endpoint is not connected|QOSMaxSubmitJobPerUserLimit|AssocMaxSubmitJobLimit'
        maxAttempts = 10
        delay       = '30s'
        maxDelay    = '5m'
    }
}

// Images pulled on a login node by ./run.sh setup (compute nodes have no internet)
apptainer {
    cacheDir = "${System.getenv('SFT_ROOT')}/containers"
}

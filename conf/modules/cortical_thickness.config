process {

    withName: ".*:RECONALL_THICKNESS(_RERUN)?" {
        // recon-all -all runs on one thread whatever the CPUs: without -openmp it uses one OpenMP thread
        // in every step (recon-all.log: "Starting parallel 1", "1 threads"), even with the
        // OMP_NUM_THREADS=task.cpus the module exports. So one CPU, not four left idle. Single-threaded
        // runs are also the reproducible ones. About 2 h 20 per ADNI T1 on Fir.
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 24.h * task.attempt }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/freesurfer/" : "${params.outdir}/${meta.id}/anat/freesurfer/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith("__recon_all") ? filename.replace("__recon_all", "") : null }
        ]
    }

    withName: ".*:SEGMENTATION_HIPPOAMYG" {
        // segment_subregions hippo-amygdala: about 5 min per T1 with 4 threads (OASIS-3)
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/freesurfer/" : "${params.outdir}/${meta.id}/anat/freesurfer/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith("__hippoamyg") ? filename.replace("__hippoamyg", "_hippoamyg") : null }
        ]
    }

    withName: ".*:STATS_HIPPOAMYG" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith("_hippoamyg.csv") ? "${prefix}_seg-reconall_desc-hippoamyg_volumes.csv" : null
            }
        ]
    }

    withName: ".*:STATS_THICKNESS" {
        ext.thickness_method = "recon-all"
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith("_thickness.csv") ? "${prefix}_desc-thickness.csv" : null
            }
        ]
    }

    withName: ".*:STATS_SURFACEMETRICS" {
        ext.projfrac     = 0.5   // fraction of the way from the white to the pial surface (mid-thickness)
        ext.meta_columns = { params.tractometry_covariates.split(",") }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith("_desc-mean_surface_stats.tsv") ) { "${prefix}_surf-freesurfer_desc-roi_stats.tsv" }
                else if ( filename.endsWith("_desc-std_surface_stats.tsv") ) { "${prefix}_surf-freesurfer_label-std_desc-roi_stats.tsv" }
                else { null }
            }
        ]
    }
}

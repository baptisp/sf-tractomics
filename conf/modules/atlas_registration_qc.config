// Atlas registration QC (QC_ATLASREGISTRATION): the warped IIT b0 against each run's b0, for the
// registration that places the IIT bundles and GM regions (iit) and the one that places the CSF
// atlas (csf)
process {

    withName: ".*:QC_ATLASREG_.*" {
        // One name per run, so the merged file is sorted by subject, session and run
        ext.prefix         = { [meta.id, meta.session, meta.run].findAll().join("_") }
        ext.min_atlas_corr = { params.atlas_min_registration_corr }
        ext.min_brain_dice = { params.atlas_min_brain_dice }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                def atlas = task.ext.registration == "csf" ? "freesurfer-csf" : "iit"
                filename.endsWith("_atlasreg_qc.csv") ? "${prefix}_atlas-${atlas}_desc-registration_qc.csv" : null
            }
        ]
    }

    withName: ".*:QC_ATLASREG_IIT" {
        ext.registration = "iit"
    }

    withName: ".*:QC_ATLASREG_CSF" {
        ext.registration = "csf"
    }
}

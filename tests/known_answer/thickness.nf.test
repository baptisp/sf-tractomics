// Known-answer test of the cortical thickness files: four samples, two of them reading the stats of
// FreeSurfer's bert and two a copy with lh entorhinal thickness 0.512 mm and a 1 x 1 x 2 mm input
// (modules/local/stats/thickness/tests/data). Each sample's rows must carry its own values and
// flags in the global file, in sid / session / run order, whatever the arrival order.
nextflow_workflow {

    name "Known-answer test of the cortical thickness collection"
    script "./thickness/main.nf"
    workflow "THICKNESS_KNOWN_ANSWER"
    config "./thickness/nextflow.config"
    tag "known_answer"

    test("thickness of several samples lands in its own rows of the global file") {
        when {
            workflow {
                """
                input[0] = "${projectDir}/modules/local/stats/thickness/tests/data"
                input[1] = "${outputDir}/collected"
                """
            }
        }
        then {
            assert workflow.success
            def lines = path("${outputDir}/collected/thickness.csv").readLines()
            assert lines[0] == "sid,session,run,roi,thickness_mm,thickness_std_mm,surface_area_mm2,gm_volume_mm3,num_vertices,thickness_method,qc_flags"
            def rows = lines[1..-1].collect { l -> l.split(",", -1).toList() }
            assert rows.size() == 4 * 68
            // [sid, session, run, entorhinal thickness, flags], in file order
            def samples = [
                ["sub-01", "ses-01", "1", "3.041", ""],
                ["sub-01", "ses-02", "1", "0.512", "coarse_t1;implausible:ctx-lh-entorhinal"],
                ["sub-01", "ses-02", "2", "3.041", ""],
                ["sub-02", "ses-01", "1", "0.512", "coarse_t1;implausible:ctx-lh-entorhinal"]
            ]
            samples.eachWithIndex { s, i ->
                def block = rows[(68 * i)..<(68 * (i + 1))]
                assert block.every { r -> r[0..2] == s[0..2] } : "rows of ${s[0..2]} are not contiguous or carry another sample"
                assert block.collect { r -> r[3] }.unique().size() == 68
                assert block.find { r -> r[3] == "ctx-lh-entorhinal" }[4] == s[3]
                // Values of an unchanged region are the same in every sample
                assert block.find { r -> r[3] == "ctx-rh-insula" }[4..8] == ["2.992", "0.723", "2767", "8103", "4170"]
                assert block.every { r -> r[10] == s[4] }
            }
        }
    }
}

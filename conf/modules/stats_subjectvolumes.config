/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config for volumes from the subject's own segmentation (params.volume_source)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The per-subject CSVs keep the names used by the atlas-based volumes, so downstream
    scripts read them unchanged; their volume_source column tells the two apart.
*/

process {

    withName: ".*:SYNTHSEG_VOLUMES" {
        // --robust --parc on CPU peaks at ~24 GB on a 196x256x256 T1 (measured with docker stats),
        // and the host kills it when less is free. Fixed, not scaled by attempt: more would not
        // fit a 32 GB node. --crop saves little and shifts small structures by ~2%, so it is unused.
        memory              = 28.GB
        ext.gm_parc         = true   // Desikan cortical parcels, needed for the GM regions
        ext.robust          = true   // Robust model: handles heterogeneous clinical/multi-site scans
        ext.output_volume   = true   // --vol: soft volumes per structure, including total intracranial
        ext.output_qc_score = true
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith("__aparc_aseg.nii.gz") ) { "${prefix}_desc-synthseg_dseg.nii.gz" }
                else if ( filename.endsWith("__volume.csv") ) { "${prefix}_desc-synthseg_volumes.csv" }
                else if ( filename.endsWith("__qc_score.csv") ) { "${prefix}_desc-synthseg_qc.csv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:STATS_SUBJECT_GM_VOLUMES" {
        ext.first_suffix  = "atlas-iit-gm"
        ext.volume_source = params.volume_source
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith(".csv") ? "${prefix}_atlas-iit-gm_desc-roi_volumes.csv" : null
            }
        ]
    }

    withName: ".*:STATS_SUBJECT_CSF_VOLUMES" {
        ext.first_suffix  = "atlas-freesurfer-csf"
        ext.volume_source = params.volume_source
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith(".csv") ? "${prefix}_atlas-freesurfer-csf_desc-roi_volumes.csv" : null
            }
        ]
    }

    withName: ".*:STATS_SUBJECT_COMPARISON_VOLUMES" {
        ext.first_suffix  = "atlas-freesurfer-comparison"
        ext.volume_source = params.volume_source
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/comparison/" : "${params.outdir}/${meta.id}/dwi/comparison/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith(".csv") ? "${prefix}_atlas-freesurfer-comparison_desc-roi_volumes.csv" : null
            }
        ]
    }
}

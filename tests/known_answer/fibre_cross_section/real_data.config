// Settings of real_data.nf on one workstation (the template step uses up to 16 CPUs)
process {
    ext.prefix = { [meta.id, meta.session ?: "", meta.run ?: ""].findAll { x -> x }.join("_") }
    withName: "TEMPLATE_FODPOPULATION" { cpus = 16; memory = 24.GB; ext.voxel_size = 1.25 }
    withName: "REGISTRATION_FODTEMPLATE" { cpus = 4; ext.min_orientation_agreement = 0.8 }
}

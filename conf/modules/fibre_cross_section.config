// Fibre cross-section (--run_fibre_cross_section, --fc_build_template)
process {

    withName: ".*:RECONST_FODTOMRTRIX" {
        ext.in_basis = { params.basis }
        memory       = { 8.GB * task.attempt }
    }

    withName: ".*:TEMPLATE_FODPOPULATION" {
        // population_template on about 40 fODFs: hours, run once per study
        ext.voxel_size = { params.fc_template_voxel_size }
        cpus           = 16
        memory         = { 32.GB * task.attempt }
        time           = { 48.h * task.attempt }
    }

    withName: ".*:TEMPLATE_IITBUNDLES" {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }

    withName: ".*:TEMPLATE_FCBUNDLEFIXELS" {
        ext.manifest_params = { [
            fc_template_voxel_size: params.fc_template_voxel_size,
            fodf_shells: params.fodf_shells,
            min_fodf_shell_value: params.min_fodf_shell_value,
            sh_order: params.sh_order,
            basis: params.basis,
            manual_frf: params.manual_frf,
            mean_frf: params.mean_frf,
            run_dwi_normalize: params.run_dwi_normalize
        ] }
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == "versions.yml" ? null : filename }
        ]
    }

    withName: ".*:REGISTRATION_FODTEMPLATE" {
        ext.min_orientation_agreement = { params.fc_min_orientation_agreement }
        // One thread: mrregister is not reproducible on several (two runs of one session on 4
        // threads gave warps up to 0.04 mm apart, log FC up to 0.0016; on 1 thread, identical).
        // 4 threads ran ~7 min at ~3.9 cores, 1 thread ~10 min on one core: same throughput.
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: ".*:STATS_FIBRECROSSSECTION" {
        memory = { 8.GB * task.attempt }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.endsWith("_fc_stats.csv") ) { "${prefix}_space-fctemplate_desc-fc_stats.csv" }
                else if ( filename.endsWith("__logfc.mif") ) { "${prefix}_space-fctemplate_desc-logfc.mif" }
                else { null }
            }
        ]
    }
}

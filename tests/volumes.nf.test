// Stub runs of the subject-segmentation volume branches (SynthSeg, SAMSEG longitudinal) through the
// whole pipeline: they check the wiring and the output files, not the volumes (stubs write no data).
nextflow_pipeline {

    options "-stub-run"

    name "Test pipeline volumes"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_volumes"

    test("-profile test - volume_source synthseg") {

        when {
            params {
                outdir             = "$outputDir"
                run_gm_volumes     = true
                run_csf_volumes    = true
                run_csf_comparison_volumes = true
                run_merge_all_stats = true
                volume_source      = "synthseg"
                freesurfer_license = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SYNTHSEG_VOLUMES") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SAMSEG_LONG_VOLUMES") }.isEmpty() },
                // Off by default
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_HOC") }.isEmpty() },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("RECONALL_THICKNESS") }.isEmpty() },
                { assert "sub-test-1/anat/sub-test-1_desc-synthseg_dseg.nii.gz" in files },
                { assert "sub-test-1/anat/sub-test-1_seg-synthseg_label-gm_desc-roi_volumes.csv" in files },
                { assert "sub-test-1/anat/sub-test-1_seg-synthseg_label-csf_desc-roi_volumes.csv" in files },
                { assert "sub-test-1/anat/comparison/sub-test-1_seg-synthseg_label-comparison_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-synthseg_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/comparison/space-native_seg-synthseg_label-comparison_desc-roi_volumes.csv" in files },
                // 'synthseg' alone: no atlas volume file
                { assert !("metrics/space-native_atlas-iit-gm_desc-roi_volumes.csv" in files) },
                // atlas volume processes must not run when the subject's segmentation is used
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("ATLAS_CSF_ROIMETRICS") }.isEmpty() }
            )
        }
    }

    test("-profile test - volume_source reconall shares one recon-all with the thickness") {

        when {
            params {
                outdir             = "$outputDir"
                run_gm_volumes     = true
                run_csf_volumes    = true
                run_hoc            = true
                run_cortical_thickness = true
                run_merge_all_stats = true
                volume_source      = "reconall"
                freesurfer_license = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            assertAll(
                { assert workflow.success },
                // One recon-all per T1, read by the volumes, the HOC and the thickness
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("RECONALL_THICKNESS") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SEGMENTATION_RECONALLSEG") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_THICKNESS") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_HOC") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SYNTHSEG_VOLUMES") }.isEmpty() },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SAMSEG_LONG_VOLUMES") }.isEmpty() },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("ATLAS_CSF_ROIMETRICS") }.isEmpty() },
                { assert "sub-test-1/anat/sub-test-1_desc-reconall_dseg.nii.gz" in files },
                { assert "sub-test-1/anat/sub-test-1_desc-reconall_icv.csv" in files },
                { assert "sub-test-1/anat/sub-test-1_seg-reconall_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-reconall_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-reconall_desc-hoc.csv" in files },
                { assert "metrics/space-native_desc-cortical-thickness.csv" in files }
            )
        }
    }

    test("-profile test - volume_source atlas,synthseg,reconall: each source its own files and rows") {

        when {
            params {
                outdir             = "$outputDir"
                run_atlas_roimetrics = true
                run_gm_volumes     = true
                run_csf_volumes    = true
                run_hoc            = true
                run_merge_all_stats = true
                run_subject_roi_metrics = true
                volume_source      = "atlas,synthseg,reconall"
                freesurfer_license = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) } }
            assertAll(
                { assert workflow.success },
                { assert tasks("SYNTHSEG_VOLUMES").size() == 1 },
                { assert tasks("RECONALL_THICKNESS").size() == 1 },
                // one volume task per sample and subject source, one HOC per subject source
                { assert tasks("STATS_SUBJECT_GM_VOLUMES").size() == 2 },
                { assert tasks("STATS_HOC").size() == 2 },
                // one registration QC per sample and atlas registration (IIT regions, CSF atlas)
                { assert tasks("QC_ATLASREG_IIT").size() == 1 },
                { assert tasks("QC_ATLASREG_CSF").size() == 1 },
                { assert "sub-test-1/dwi/sub-test-1_atlas-iit_desc-registration_qc.csv" in files },
                { assert "sub-test-1/dwi/sub-test-1_atlas-freesurfer-csf_desc-registration_qc.csv" in files },
                { assert path("${params.outdir}/metrics/space-native_desc-atlasregistration_qc.csv").readLines()[0] ==
                         "sid,session,run,registration,atlas_b0_corr,brain_dice,qc_flags" },
                { assert "metrics/space-native_atlas-iit-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-synthseg_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-reconall_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_atlas-freesurfer-csf_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-synthseg_label-csf_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-reconall_label-csf_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-synthseg_desc-hoc.csv" in files },
                { assert "metrics/space-native_seg-reconall_desc-hoc.csv" in files },
                { assert "sub-test-1/anat/sub-test-1_seg-synthseg_label-gm_desc-roi_volumes.csv" in files },
                { assert "sub-test-1/anat/sub-test-1_seg-reconall_label-gm_desc-roi_volumes.csv" in files },
                // subject-region metrics on the first subject source only, named after it (never the list)
                { assert tasks("STATS_SUBJECT_ROI_METRICS").size() == 1 },
                { assert "sub-test-1/dwi/sub-test-1_seg-synthseg_desc-roi_stats.tsv" in files },
                { assert "sub-test-1/dwi/sub-test-1_seg-synthseg_desc-roi_fractions.csv" in files },
                { assert "metrics/space-native_seg-synthseg_label-mean_desc-roi_stats.tsv" in files },
                { assert files.findAll { f -> f.contains(",") }.isEmpty() },
                { assert path("${params.outdir}/metrics/space-native_all-regions_desc-roi_combined.tsv").readLines()[0].split("\t").toList().take(6) ==
                         ["sid", "session", "run", "roi", "region_type", "source"] }
            )
        }
    }

    test("an unknown volume source stops with a clear message") {

        when {
            params {
                outdir        = "$outputDir"
                run_gm_volumes = true
                volume_source = "synthseg,fastsurfer"
            }
        }

        then {
            assert !workflow.success
        }
    }

    test("-profile test - run_dwi_processing = false: only the T1 branch runs") {

        when {
            params {
                outdir             = "$outputDir"
                run_gm_volumes     = true
                run_hoc            = true
                run_dwi_processing = false
                volume_source      = "synthseg"
                freesurfer_license = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) } }
            assertAll(
                { assert workflow.success },
                { assert tasks("TRACTOFLOW").isEmpty() },
                { assert tasks("ATLAS_ROIMETRICS").isEmpty() },
                { assert tasks("SYNTHSEG_VOLUMES").size() == 1 },
                { assert tasks("STATS_SUBJECT_GM_VOLUMES").size() == 1 },
                { assert "metrics/space-native_seg-synthseg_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-synthseg_desc-hoc.csv" in files },
                { assert !files.any { f -> f.contains("dwimap") } }
            )
        }
    }

    test("-profile test - run_hippocampal_subfields shares the recon-all") {

        when {
            params {
                outdir                    = "$outputDir"
                run_cortical_thickness    = true
                run_hippocampal_subfields = true
                freesurfer_license        = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: true).collect { f -> f.toString() }
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) } }
            assertAll(
                { assert workflow.success },
                { assert tasks("RECONALL_THICKNESS").size() == 1 },
                { assert tasks("SEGMENTATION_HIPPOAMYG").size() == 1 },
                { assert tasks("STATS_HIPPOAMYG").size() == 1 },
                { assert "sub-test-1/anat/sub-test-1_seg-reconall_desc-hippoamyg_volumes.csv" in files },
                { assert "sub-test-1/anat/freesurfer/sub-test-1_hippoamyg" in files },
                { assert "metrics/space-native_seg-reconall_desc-hippoamyg_volumes.csv" in files }
            )
        }
    }

    test("-profile test - run_longitudinal_volumes") {

        when {
            params {
                outdir             = "$outputDir"
                run_gm_volumes     = true
                run_csf_volumes    = true
                run_longitudinal_volumes = true
                freesurfer_license = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SAMSEG_LONG_VOLUMES") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SYNTHSEG_VOLUMES") }.isEmpty() },
                { assert "sub-test-1/anat/sub-test-1_desc-samseglong_dseg.nii.gz" in files },
                { assert "sub-test-1/anat/sub-test-1_seg-samseg_label-gm_desc-roi_volumes.csv" in files },
                { assert "metrics/space-native_seg-samseg_label-csf_desc-roi_volumes.csv" in files }
            )
        }
    }

    // SAMSEG segments one T1 per session (the first run's). Its segmentation must reach every DWI run
    // that shares that T1 file (sub-INTB run-2), and not a run with another T1 file (run-3), which is
    // warned about instead. TractoFlow is skipped (volumes_integrity config).
    test("run_longitudinal_volumes - the session's segmentation reaches every run sharing its T1") {

        config "./volumes_integrity/nextflow.config"

        when {
            params {
                def d = "${projectDir}/tests/volumes_integrity"
                // subject, session, run, run of the T1 file
                def samples = [["INTA", "01", 0, 0], ["INTA", "02", 0, 0], ["INTB", "01", 1, 1], ["INTB", "01", 2, 1], ["INTB", "01", 3, 2]]
                def config = samples.collect { sub, ses, run, f -> [
                    subject: sub, session: ses, run: run,
                    t1: "${d}/t1_${sub}_${ses}_r${f}.nii.gz", dwi: "${d}/dummy.nii.gz", bval: "${d}/dummy.bval", bvec: "${d}/dummy.bvec",
                    TotalReadoutTime: 0.062, DWIPhaseEncodingDir: "y", rev_DWIPhaseEncodingDir: "",
                    rev_dwi: "", rev_bval: "", rev_bvec: "", topup: "", rev_topup: "", wmparc: "", aparc_aseg: ""
                ] }
                def cfg = new File("${outputDir}/bids_struct.json")
                cfg.parentFile.mkdirs()
                cfg.text = groovy.json.JsonOutput.toJson(config)

                outdir                   = "$outputDir/out"
                input                    = null
                bids_config              = cfg.absolutePath
                run_gm_volumes           = true
                run_hoc                  = true
                run_longitudinal_volumes = true
                freesurfer_license       = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) } }
            def anat = "$outputDir/out/sub-INTB/ses-01/anat"
            def log = new File("${launchDir}/meta/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert tasks("SAMSEG_LONG_VOLUMES").size() == 2 },
                // sub-INTA ses-01 and ses-02, sub-INTB run-1 and run-2; not run-3
                { assert tasks("STATS_HOC").size() == 4 },
                { assert tasks("STATS_SUBJECT_GM_VOLUMES").size() == 4 },
                { assert path("${anat}/sub-INTB_ses-01_run-1_seg-samseg_desc-hoc.csv").exists() },
                { assert path("${anat}/sub-INTB_ses-01_run-2_seg-samseg_desc-hoc.csv").exists() },
                { assert !path("${anat}/sub-INTB_ses-01_run-3_seg-samseg_desc-hoc.csv").exists() },
                { assert log.readLines().any { l -> l.contains("another T1 file") && l.contains("sub-INTB_ses-01_run-3") } }
            )
        }
    }
}

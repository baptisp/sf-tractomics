// Options reach the steps they control: stub runs of the whole pipeline, checking which tasks run.
nextflow_pipeline {

    options "-stub-run"

    name "Test pipeline options"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_options"

    // Text of every task script under a work directory
    def commandScripts = { dir ->
        def found = []
        new File(dir).eachFileRecurse(groovy.io.FileType.FILES) { f -> if (f.name == ".command.sh") found << f.text }
        found
    }

    test("run_t1_resampling = false skips the T1 resampling") {

        when {
            params {
                outdir            = "$outputDir"
                run_t1_resampling = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("PREPROC_T1:IMAGE_RESAMPLE") }.isEmpty() },
                // fODF peak threshold from each subject's ventricles by default
                { assert commandScripts("${launchDir}/work").count { t -> t.contains("# settings: absolute_threshold none") } == 1 },
                // Every option the workflow passes to TractoFlow must be one it knows
                { assert !new File("${launchDir}/meta/nextflow.log").text.contains("Unknown option") }
            )
        }
    }

    test("fodf_absolute_threshold sets one fODF peak threshold, and the threshold file is published") {

        when {
            params {
                outdir                  = "$outputDir"
                fodf_absolute_threshold = 0.3
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert commandScripts("${launchDir}/work").count { t -> t.contains("# settings: absolute_threshold 0.3") } == 1 },
                { assert {
                    def found = []
                    new File("${params.outdir}").eachFileRecurse(groovy.io.FileType.FILES) { f -> if (f.name.endsWith("_desc-fodfthreshold.csv")) found << f }
                    found.size() == 1
                }() }
            )
        }
    }

    test("run_t1_resampling = true resamples the T1") {

        when {
            params {
                outdir            = "$outputDir"
                run_t1_resampling = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("PREPROC_T1:IMAGE_RESAMPLE") }.size() == 1 },
                { assert !new File("${launchDir}/meta/nextflow.log").text.contains("Unknown option") }
            )
        }
    }

    test("use_binary_masks = true counts the WM bundle volumes by voxel fraction") {

        when {
            params {
                outdir           = "$outputDir"
                run_wm_volumes   = true
                use_binary_masks = true
            }
        }

        then {
            def scripts = commandScripts("${launchDir}/work")
            assertAll(
                { assert workflow.success },
                { assert scripts.count { t -> t.contains("# settings: mask_volume fraction") } == 1 },
                { assert !scripts.any { t -> t.contains("# settings: mask_volume nonzero") } }
            )
        }
    }

    test("run_hoc = true without a subject segmentation stops with a clear message") {

        when {
            params {
                outdir  = "$outputDir"
                run_hoc = true
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("run_hoc = true needs the subject's own segmentation") }
            )
        }
    }

    test("run_hoc = true with SynthSeg writes the HOC files; off by default") {

        when {
            params {
                outdir             = "$outputDir"
                run_hoc            = true
                volume_source      = "synthseg"
                freesurfer_license = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_HOC") }.size() == 1 },
                // HOC alone still runs the segmentation, but no volume statistics
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SYNTHSEG_VOLUMES") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_SUBJECT_") }.isEmpty() },
                { assert "sub-test-1/anat/sub-test-1_seg-synthseg_desc-hoc.csv" in files },
                { assert "metrics/space-native_seg-synthseg_desc-hoc.csv" in files }
            )
        }
    }

    test("run_cortical_thickness = true without a FreeSurfer licence stops with a clear message") {

        when {
            params {
                outdir                 = "$outputDir"
                run_cortical_thickness = true
                freesurfer_license     = null
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("run_cortical_thickness = true requires params.freesurfer_license") }
            )
        }
    }

    test("run_cortical_thickness = true runs recon-all once per T1 and writes the thickness files") {

        when {
            params {
                outdir                 = "$outputDir"
                run_cortical_thickness = true
                freesurfer_license     = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: true).collect { f -> f.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("RECONALL_THICKNESS") }.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_THICKNESS") }.size() == 1 },
                // Thickness alone needs no subject segmentation
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("SYNTHSEG_VOLUMES") }.isEmpty() },
                { assert "sub-test-1/anat/sub-test-1_desc-thickness.csv" in files },
                { assert "sub-test-1/anat/freesurfer/sub-test-1" in files },
                { assert "metrics/space-native_desc-cortical-thickness.csv" in files }
            )
        }
    }

    test("run_cortical_surface_metrics = true without a FreeSurfer licence stops with a clear message") {

        when {
            params {
                outdir                       = "$outputDir"
                run_cortical_surface_metrics = true
                freesurfer_license           = null
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("run_cortical_surface_metrics = true requires params.freesurfer_license") }
            )
        }
    }

    test("run_cortical_surface_metrics = true with thickness shares one recon-all and writes the surface files") {

        when {
            params {
                outdir                       = "$outputDir"
                run_cortical_surface_metrics = true
                run_cortical_thickness       = true
                freesurfer_license           = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) }.size() }
            assertAll(
                { assert workflow.success },
                { assert tasks("RECONALL_THICKNESS") == 1 },
                { assert tasks("STATS_THICKNESS") == 1 },
                { assert tasks("STATS_SURFACEMETRICS") == 1 },
                // The module receives the configured sampling depth (its stub records it)
                { assert commandScripts("${launchDir}/work").count { t -> t.contains("# settings: projfrac 0.5") } == 1 },
                { assert "sub-test-1/dwi/sub-test-1_surf-freesurfer_desc-roi_stats.tsv" in files },
                { assert "sub-test-1/dwi/sub-test-1_surf-freesurfer_label-std_desc-roi_stats.tsv" in files },
                { assert "metrics/space-native_surf-freesurfer_label-mean_desc-roi_stats.tsv" in files },
                { assert path("${params.outdir}/metrics/space-native_surf-freesurfer_label-mean_desc-roi_stats.tsv").readLines()[0] == "sid\tsession\trun\troi\tregion_type\tfwc_failed_fraction\tn_vertices" },
                { assert "sub-test-1/anat/sub-test-1_desc-thickness.csv" in files }
            )
        }
    }

    test("run_cortical_surface_metrics = true alone runs recon-all but not the thickness table") {

        when {
            params {
                outdir                       = "$outputDir"
                run_cortical_surface_metrics = true
                freesurfer_license           = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) }.size() }
            assertAll(
                { assert workflow.success },
                { assert tasks("RECONALL_THICKNESS") == 1 },
                { assert tasks("STATS_THICKNESS") == 0 },
                { assert tasks("STATS_SURFACEMETRICS") == 1 }
            )
        }
    }

    test("run_subject_roi_metrics = true without a subject segmentation stops with a clear message") {

        when {
            params {
                outdir                  = "$outputDir"
                run_subject_roi_metrics = true
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("run_subject_roi_metrics = true needs the subject's own segmentation") }
            )
        }
    }

    test("run_subject_roi_metrics = true with SynthSeg writes the subject-region metric files") {

        when {
            params {
                outdir                   = "$outputDir"
                run_subject_roi_metrics  = true
                subject_roi_min_fraction = 0.75
                subject_roi_small_region_voxels = 30
                volume_source            = "synthseg"
                freesurfer_license       = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            def files = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }
            def fractions = workflow.trace.tasks().findAll { t -> t.name.contains("SUBJECT_ROI_FRACTIONS") }
            assertAll(
                { assert workflow.success },
                { assert fractions.size() == 1 },
                { assert workflow.trace.tasks().findAll { t -> t.name.contains("STATS_SUBJECT_ROI_METRICS") }.size() == 1 },
                // The threshold reaches the module (its stub records the settings it received)
                { assert commandScripts("${launchDir}/work").count { t -> t.contains("# settings: supersampling 4 min_fraction 0.75 small_region_voxels 30") } == 1 },
                { assert "sub-test-1/dwi/sub-test-1_seg-synthseg_desc-roi_stats.tsv" in files },
                { assert "sub-test-1/dwi/sub-test-1_seg-synthseg_label-std_desc-roi_stats.tsv" in files },
                { assert "sub-test-1/dwi/sub-test-1_seg-synthseg_desc-roi_fractions.csv" in files },
                { assert "metrics/space-native_seg-synthseg_desc-roi_fractions.csv" in files },
                // The atlas GM files are unchanged and separate
                { assert !files.any { f -> f.contains("_fraction.nii.gz") } }
            )
        }
    }

    test("a sample with no fODF shell is processed without fibre response, fODF or AFD") {

        // The test DWI has b300, b1000 and b2000: no b1300. Eddy and topup off, so the fODF step
        // reads the real b-values (their stubs write empty ones).
        when {
            params {
                outdir         = "$outputDir"
                fodf_shells    = "1300"
                run_eddy       = false
                run_topup      = false
                // NODDI's own b-value check fails without eddy (bval.text in reconst_fw_noddi):
                // a separate, older issue
                run_noddi      = false
                run_freewater  = false
                run_wm_metrics = true
            }
        }

        then {
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) } }
            assertAll(
                { assert workflow.success },
                { assert tasks("RECONST_FRF").isEmpty() },
                { assert tasks("RECONST_FODF").isEmpty() },
                { assert tasks("RECONST_DTIMETRICS").size() == 1 },
                // The other metrics still reach the bundle statistics
                { assert tasks("STATS_MASK_METRICS").size() == 1 },
                { assert path("${params.outdir}/metrics/dwi_input_report.tsv").text.contains("no fODF shell") },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("have no fODF shell") }
            )
        }
    }

    test("run_fibre_cross_section = true without a template stops with a clear message") {

        when {
            params {
                outdir                  = "$outputDir"
                run_fibre_cross_section = true
            }
        }

        then {
            assert workflow.failed
            assert new File("${launchDir}/meta/nextflow.log").text.contains("run_fibre_cross_section = true needs a study template")
        }
    }

    test("fc_build_template with run_fibre_cross_section builds the template and writes the FC files") {

        when {
            params {
                def sessions = new File("${outputDir}/fc_sessions.tsv")
                sessions.parentFile.mkdirs()
                sessions.text = "sid\tsession\trun\nsub-test-1\t\t\n"
                outdir                  = "$outputDir/out"
                run_fibre_cross_section = true
                fc_build_template       = true
                fc_template_sessions    = sessions.absolutePath
            }
        }

        then {
            def tasks = { name -> workflow.trace.tasks().findAll { t -> t.name.contains(name) } }
            assertAll(
                { assert workflow.success },
                { assert tasks("RECONST_FODTOMRTRIX").size() == 1 },
                { assert tasks("TEMPLATE_FODPOPULATION").size() == 1 },
                { assert tasks("TEMPLATE_IITBUNDLES").size() == 1 },
                { assert tasks("TEMPLATE_FCBUNDLEFIXELS").size() == 1 },
                { assert tasks("REGISTRATION_FODTEMPLATE").size() == 1 },
                { assert tasks("STATS_FIBRECROSSSECTION").size() == 1 },
                { assert path("${params.outdir}/fc_template/manifest.json").exists() },
                { assert path("${params.outdir}/sub-test-1/dwi/sub-test-1_space-fctemplate_desc-fc_stats.csv").exists() },
                { assert path("${params.outdir}/metrics/space-template_desc-fc_stats.csv").exists() },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("this one is for testing only") }
            )
        }
    }

    test("fc_template whose files changed since it was built stops with a clear message") {

        when {
            params {
                def dir = new File("${outputDir}/old_template")
                dir.mkdirs()
                new File(dir, "fod_template.mif").text = "edited"
                new File(dir, "manifest.json").text = '{"parameters": {}, "sessions": ["sub-a"], "files": {"fod_template.mif": "0000"}}'
                outdir                  = "$outputDir/out"
                run_fibre_cross_section = true
                fc_template             = dir.absolutePath
            }
        }

        then {
            assert workflow.failed
            assert new File("${launchDir}/meta/nextflow.log").text.contains("1 file(s) missing or changed since the template was built (fod_template.mif)")
        }
    }

    test("parameters set in a -c config file reach the steps") {

        // Loaded with -c, after nextflow.config: the module settings must still see these values
        config "./params_in_config.config"

        when {
            params {
                outdir                  = "$outputDir"
                run_subject_roi_metrics = true
                volume_source           = "synthseg"
                freesurfer_license      = "${projectDir}/tests/fake_freesurfer_license.txt"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert commandScripts("${launchDir}/work").count { t -> t.contains("# settings: supersampling 4 min_fraction 0.6 small_region_voxels 50") } == 1 }
            )
        }
    }
}

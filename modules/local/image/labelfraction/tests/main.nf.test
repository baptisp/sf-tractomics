// Known-answer tests on synthetic grids (tests/data):
//   acquisition grid  4x4x4 voxels of 2 mm (acq voxel i centred at x = 2i)
//   target grid       8x8x8 voxels of 1 mm, each acquisition voxel holds 2x2x2 target voxels
//   labels            0.5 mm grid matching the 4x refined acquisition grid exactly:
//     17 Left-Hippocampus   fills acquisition voxel (1,1,1) and half of (2,1,1) -> 1.5 voxels, 12 mm3
//      5 Left-Inf-Lat-Vent  fills a quarter of acquisition voxel (3,3,3)        -> 0.25 voxel, 2 mm3
//     53 Right-Hippocampus  absent                                              -> 0, no map
// Expected target maps: Left-Hippocampus 1 on target x 2-3 and 0.5 on x 4-5 (y, z 2-3), 8 voxels
// each; Left-Inf-Lat-Vent 0.25 on x, y, z 6-7. ITK transforms are in LPS: +2 mm along LPS x moves
// the content one acquisition voxel up the RAS x axis, so the ventricle leaves the grid.
nextflow_process {

    name "Test Process IMAGE_LABELFRACTION"
    script "../main.nf"
    process "IMAGE_LABELFRACTION"

    tag "modules"
    tag "modules_local"
    tag "image/labelfraction"

    // Value -> [count, x range, y range, z range] of the voxels holding it
    def describe = { map ->
        def cmd = ["docker", "run", "--rm", "-v", "${map.parent}:${map.parent}",
                   "community.wave.seqera.io/library/nibabel_numpy:4148b92a8cbc6976", "python3", "-c",
                   "import nibabel as nib, numpy as np\n" +
                   "a = np.asarray(nib.load('${map}').dataobj)\n" +
                   "out = []\n" +
                   "for v in sorted(set(np.unique(a).tolist()) - {0.0}):\n" +
                   "    w = np.argwhere(a == v)\n" +
                   "    out.append(f'{v:g}:{len(w)}:' + ','.join(f'{w[:, i].min()}-{w[:, i].max()}' for i in range(3)))\n" +
                   "print(' '.join(out))"]
        def p = cmd.execute(); p.waitFor(); p.text.trim()
    }
    def mapOf = { maps, roi -> maps.find { f -> file(f).name == "sub-01__${roi}_fraction.nii.gz" } }

    test("labelfraction - identity: exact fractions, sums and maps") {

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"), [], [] ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.sums[0][1]).readLines() == [
                "sid,session,run,roi,acq_voxels,volume_mm3,in_mask_fraction,small_region,fwc_failed_fraction",
                "sub-01,,1,Left-Inf-Lat-Vent,0.2500,2.0000,1.0000,1,",
                "sub-01,,1,Left-Hippocampus,1.5000,12.0000,1.0000,1,",
                "sub-01,,1,Right-Hippocampus,0.0000,0.0000,,1,"
            ]
            def maps = process.out.fractions[0][1]
            assert maps.collect { f -> file(f).name }.sort() == ["sub-01__Left-Hippocampus_fraction.nii.gz", "sub-01__Left-Inf-Lat-Vent_fraction.nii.gz"]
            assert describe(file(mapOf(maps, "Left-Hippocampus"))) == "0.5:8:4-5,2-3,2-3 1:8:2-3,2-3,2-3"
            assert describe(file(mapOf(maps, "Left-Inf-Lat-Vent"))) == "0.25:8:6-7,6-7,6-7"
            // versions.yml must be valid YAML with plain version numbers (Nextflow parses it)
            def versions = new org.yaml.snakeyaml.Yaml().load(path(process.out.versions[0]).text)
            def tools = versions["IMAGE_LABELFRACTION"]
            assert tools.keySet() == ["nibabel", "numpy", "ants"] as Set
            assert tools.values().every { v -> v.toString() ==~ /[0-9][0-9.]*[0-9a-zA-Z-]*/ } : tools
        }
    }

    test("labelfraction - 2 mm translation moves the fractions by one acquisition voxel") {

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/shift_2mm_x.txt"), file("\${d}/lut.json"), [], [] ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.sums[0][1]).readLines()[1..3] == [
                "sub-01,,1,Left-Inf-Lat-Vent,0.0000,0.0000,,1,",
                "sub-01,,1,Left-Hippocampus,1.5000,12.0000,1.0000,1,",
                "sub-01,,1,Right-Hippocampus,0.0000,0.0000,,1,"
            ]
            def maps = process.out.fractions[0][1]
            maps = maps instanceof List ? maps : [maps]
            assert describe(file(mapOf(maps, "Left-Hippocampus"))) == "0.5:8:6-7,2-3,2-3 1:8:4-5,2-3,2-3"
        }
    }

    test("labelfraction - min_fraction keeps only voxels mostly inside, as a binary mask") {

        config "./nextflow_threshold.config"

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"), [], [] ]
                """
            }
        }

        then {
            assert process.success
            def maps = process.out.fractions[0][1]
            maps = maps instanceof List ? maps : [maps]
            assert describe(file(mapOf(maps, "Left-Hippocampus"))) == "1:8:2-3,2-3,2-3"
            // Below the threshold everywhere: no mask, so the region is absent from the stats
            assert maps.collect { f -> file(f).name } == ["sub-01__Left-Hippocampus_fraction.nii.gz"]
        }
    }

    test("labelfraction - brain mask: no weight outside it, share inside reported") {

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"),
                             file("\${d}/brain_mask_x0-5.nii.gz"), [] ]
                """
            }
        }

        then {
            assert process.success
            // The mask stops at target x = 5: the ventricle (x 6-7) is outside, the hippocampus inside
            assert path(process.out.sums[0][1]).readLines()[1..2] == [
                "sub-01,,1,Left-Inf-Lat-Vent,0.2500,2.0000,0.0000,1,",
                "sub-01,,1,Left-Hippocampus,1.5000,12.0000,1.0000,1,"
            ]
            def maps = process.out.fractions[0][1]
            maps = maps instanceof List ? maps : [maps]
            assert maps.collect { f -> file(f).name } == ["sub-01__Left-Hippocampus_fraction.nii.gz"]
            assert describe(file(mapOf(maps, "Left-Hippocampus"))) == "0.5:8:4-5,2-3,2-3 1:8:2-3,2-3,2-3"
        }
    }

    test("labelfraction - brain mask cutting a region: in_mask_fraction is the share kept") {

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"),
                             file("\${d}/brain_mask_x0-3.nii.gz"), [] ]
                """
            }
        }

        then {
            assert process.success
            // The mask stops at target x = 3: of the hippocampus weight (8 voxels at 1 for x 2-3,
            // 8 at 0.5 for x 4-5, 12 in all), 8 is kept, 8/12 = 0.6667. Volumes stay those of the labels.
            assert path(process.out.sums[0][1]).readLines()[1..2] == [
                "sub-01,,1,Left-Inf-Lat-Vent,0.2500,2.0000,0.0000,1,",
                "sub-01,,1,Left-Hippocampus,1.5000,12.0000,0.6667,1,"
            ]
            def maps = process.out.fractions[0][1]
            maps = maps instanceof List ? maps : [maps]
            assert maps.collect { f -> file(f).name } == ["sub-01__Left-Hippocampus_fraction.nii.gz"]
            assert describe(file(mapOf(maps, "Left-Hippocampus"))) == "1:8:2-3,2-3,2-3"
        }
    }

    test("labelfraction - fwc_failed_fraction: share of the weight on brain voxels where a fwc map is 0") {

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                // brain mask x 0-5; the fwc map is 0 from x = 4 (a fit that failed there)
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"),
                             file("\${d}/brain_mask_x0-5.nii.gz"), [ file("\${d}/brain_mask_x0-3.nii.gz") ] ]
                """
            }
        }

        then {
            assert process.success
            // hippocampus weight: 8 voxels at 1 (x 2-3) and 8 at 0.5 (x 4-5), 12 in all; the failed
            // voxels hold 4 of it: 0.3333. The ventricle (x 6-7) is outside the brain mask: no weight,
            // empty. Nothing is removed: volumes, in_mask_fraction and the map are unchanged.
            assert path(process.out.sums[0][1]).readLines()[1..2] == [
                "sub-01,,1,Left-Inf-Lat-Vent,0.2500,2.0000,0.0000,1,",
                "sub-01,,1,Left-Hippocampus,1.5000,12.0000,1.0000,1,0.3333"
            ]
            def maps = process.out.fractions[0][1]
            maps = maps instanceof List ? maps : [maps]
            assert describe(file(mapOf(maps, "Left-Hippocampus"))) == "0.5:8:4-5,2-3,2-3 1:8:2-3,2-3,2-3"
        }
    }

    test("labelfraction - small_region flags regions under ext.small_region_voxels acquired voxels") {

        config "./nextflow_small.config"

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"), [], [] ]
                """
            }
        }

        then {
            assert process.success
            // threshold 1: the hippocampus (1.5 acquired voxels) is not small, the ventricle (0.25) is
            assert path(process.out.sums[0][1]).readLines()[1..2] == [
                "sub-01,,1,Left-Inf-Lat-Vent,0.2500,2.0000,1.0000,1,",
                "sub-01,,1,Left-Hippocampus,1.5000,12.0000,1.0000,0,"
            ]
        }
    }

    test("labelfraction - stub") {

        options "-stub-run"

        when {
            process {
                """
                def d = "${moduleDir}/tests/data"
                input[0] = [ [ id:'sub-01' ], file("\${d}/labels.nii.gz"), file("\${d}/acq_dwi.nii.gz"),
                             file("\${d}/target_fa.nii.gz"), file("\${d}/identity.txt"), file("\${d}/lut.json"), [], [] ]
                """
            }
        }

        then {
            assert process.success
        }
    }
}

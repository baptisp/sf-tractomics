// Known-answer tests on a synthetic 10x10x10 segmentation:
//   label 17 (Left-Hippocampus)   30 voxels
//   label  5 (Left-Inf-Lat-Vent)  10 voxels
//   label 53 (Right-Hippocampus)  20 voxels
//   label 44 (Right-Inf-Lat-Vent) absent
//   label  2                      10 voxels, ignored
// Expected HOC: Left 30/40 = 0.75, Right 20/20 = 1, Bilateral 50/60 = 0.833333.
// The same labels stored with 1 x 1 x 2 mm voxels double every volume but leave every HOC equal.
nextflow_process {

    name "Test Process STATS_HOC"
    script "../main.nf"
    process "STATS_HOC"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "stats/hoc"

    test("hoc - 1 mm voxels") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sub-01', session:'ses-01' ],
                    file("${moduleDir}/tests/data/labels_1mm.nii.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def csv = path(process.out.hoc[0][1])
            assert csv.fileName.toString() == "sub-01_ses-01_hoc.csv"
            assert csv.readLines() == [
                "sid,session,run,roi,hoc,hippocampus_mm3,inf_lat_vent_mm3,volume_source",
                "sub-01,ses-01,1,Left,0.750000,30.0000,10.0000,synthseg",
                "sub-01,ses-01,1,Right,1.000000,20.0000,0.0000,synthseg",
                "sub-01,ses-01,1,Bilateral,0.833333,50.0000,10.0000,synthseg"
            ]
        }
    }

    test("hoc - 1 x 1 x 2 mm voxels: volumes double, HOC unchanged") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sub-02', session:'', run:'run-2' ],
                    file("${moduleDir}/tests/data/labels_1x1x2mm.nii.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def csv = path(process.out.hoc[0][1])
            assert csv.readLines() == [
                "sid,session,run,roi,hoc,hippocampus_mm3,inf_lat_vent_mm3,volume_source",
                "sub-02,,2,Left,0.750000,60.0000,20.0000,synthseg",
                "sub-02,,2,Right,1.000000,40.0000,0.0000,synthseg",
                "sub-02,,2,Bilateral,0.833333,100.0000,20.0000,synthseg"
            ]
        }
    }

    test("hoc - no hippocampus and no ventricle: HOC empty, not 0 or an error") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sub-03', session:'ses-01' ],
                    file("${moduleDir}/tests/data/empty.nii.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def csv = path(process.out.hoc[0][1])
            assert csv.readLines()[1..3] == [
                "sub-03,ses-01,1,Left,,0.0000,0.0000,synthseg",
                "sub-03,ses-01,1,Right,,0.0000,0.0000,synthseg",
                "sub-03,ses-01,1,Bilateral,,0.0000,0.0000,synthseg"
            ]
        }
    }

    test("hoc - stub") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [
                    [ id:'sub-01', session:'ses-01' ],
                    file("${moduleDir}/tests/data/labels_1mm.nii.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.hoc[0][1]).readLines() == ["sid,session,run,roi,hoc,hippocampus_mm3,inf_lat_vent_mm3,volume_source"]
        }
    }
}

// How tasks run on vitalTour, never what they compute (parameters are in params/). Used with
// -profile docker,iit_tractometry. Taken from the ADNI test (test_adni_volumes/configs/vitaltour.config),
// itself from the last OASIS-3 run that passed every check.

// 32 CPUs, 31 GB of memory. SynthSeg alone needs 28 GB, so tasks never ask for more than the
// machine has and wait when memory is short.
executor {
    name   = 'local'
    cpus   = 30
    memory = 29.GB
}

process {
    resourceLimits = [ cpus: 30, memory: 29.GB, time: 48.h ]

    // Out of memory (137), time limit (140, 143), broken pipe (141) or unknown error (255): retried
    // up to 3 times. Any other failure stops the run once the running tasks finish ('finish'), so a
    // bug is seen at once instead of being skipped ('ignore').
    maxRetries    = 3
    errorStrategy = { task.exitStatus in [137, 140, 141, 143, 255] && task.attempt <= 3 ? 'retry' : 'finish' }

    // Peaks measured on ADNI (Fir, Siemens multi-shell, DWI resampled to 1 mm): FRF 4.7 GB, DTI fits
    // 6.3 GB; the earlier 4 and 6 GB were killed (137) on the first attempt of most sessions
    withName: '.*:RECONST_FRF' {
        memory = { 6.GB * task.attempt }
    }
    withName: '.*:RECONST_FREEWATER' {
        memory = { 16.GB * task.attempt }
    }
    // ADNI multi-shell on Fir: 8.3 GB peak, killed for memory (137) at the 8 GB default
    withName: '.*:RECONST_NODDI' {
        memory = { 12.GB * task.attempt }
    }
    // OASIS: the DTI fits were killed for memory (exit 137) when 8 ran at once without a memory request
    withName: '.*:RECONST_DTIMETRICS' {
        memory = { 8.GB * task.attempt }
    }
    withName: '.*:FW_CORRECTED_DTIMETRICS' {
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

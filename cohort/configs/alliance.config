// How tasks run on an Alliance cluster (Rorqual, Fir), never what they compute (parameters are in
// params/). Used with -profile apptainer,slurm,iit_tractometry: the pipeline's slurm profile submits
// one Slurm job per task (executor, queue polling, job names, lenient cache, apptainer
// --containall); this file adds the account, the node-local scratch, resource caps and retries.
// Every task runs on CPU: no step of these runs needs a GPU (eddy is eddy_cpu, tracking is off).

process {
    // Slurm account of config.env. The comment tags every task job with its launch folder (root
    // folder, or batch), so packing a batch can wait for, or cancel, the task jobs it left behind.
    clusterOptions = "--account=${System.getenv('SFT_ACCOUNT')} --comment=${System.getenv('SFT_TAG')}"
    // Node-local disk of the job: inputs and intermediate files stay off the shared file system
    scratch        = '$SLURM_TMPDIR'
    beforeScript   = 'module load apptainer'

    // Rorqual and Fir CPU nodes have 192 cores and about 750 GB; one task never needs a whole node.
    // SynthSeg needs about 28 GB; recon-all about 7 h on one T1.
    resourceLimits = [ cpus: 32, memory: 128.GB, time: 48.h ]

    // Out of memory (137), time limit (140, 143), broken pipe (141), unknown error (255) or a task job
    // gone without an exit code (Integer.MAX_VALUE: node failure, a job cancelled by hand; Rorqual,
    // a container hung at start, cancelled): retried up to 3 times with the larger request of the next
    // attempt. Any other failure is left ('ignore'): one session's failure (e.g. an N4 that diverges
    // on one T1) no longer stops the other sessions of its batch; the failed task is listed in
    // out/metrics/failed_tasks.tsv (scripts/failure_report.py). A failure of more than
    // MAX_FAILED_FRACTION of the batch's DWI runs (a bug, not a run) still fails the pass.
    maxRetries    = 3
    errorStrategy = { task.exitStatus in [137, 140, 141, 143, 255, Integer.MAX_VALUE] && task.attempt <= 3 ? 'retry' : 'ignore' }

    // Statistics tasks take seconds to 12 min (ADNI, Rorqual). A container that hangs at start (seen
    // once on Rorqual: Apptainer waiting, no process, 40 min) then dies at 1 h and is retried, instead
    // of holding its batch to the 4 h default
    withName: '.*:STATS_.*' {
        time = { 1.h * task.attempt }
    }

    // First request of each attempt, from the peaks of the ADNI test batches on Rorqual (3 subjects,
    // 6 sessions: single and multi-shell, with and without field map, DWI resampled to 1 mm) and on
    // Fir (multi-shell): at least 30% above the largest peak, so a session fails for
    // memory only when it is larger than any seen. Peaks: eddy 22.5 GB (12 GB killed), SynthSeg
    // 35.9 GB on a 1.2 mm ADNI2 T1 (32 GB killed), b0 extraction and DWI brain extraction 4.3 GB
    // (4 GB killed), subject-region fractions 5.2 GB (4 GB killed), T1 to DWI registration 3.1 GB,
    // FRF 5.4 GB, DTI 8.3 GB (Fir) and free-water-corrected DTI 7.3 GB, free water 14.1 GB, NODDI
    // 10.2 GB.
    // Requested memory is not part of the task hash: changing it recomputes nothing.
    withName: '.*:PREPROC_EDDY' {
        memory = { 30.GB * task.attempt }
    }
    withName: '.*:SYNTHSEG_VOLUMES' {
        memory = { 48.GB * task.attempt }
    }
    withName: '.*:(EXTRACT_B0|UTILS_EXTRACTB0|BETCROP_FSLBETCROP)' {
        memory = { 8.GB * task.attempt }
    }
    withName: '.*:SUBJECT_ROI_FRACTIONS' {
        memory = { 8.GB * task.attempt }
    }
    withName: '.*:REGISTRATION_ANATTODWI' {
        memory = { 6.GB * task.attempt }
    }
    withName: '.*:RECONST_FRF' {
        memory = { 8.GB * task.attempt }
    }
    withName: '.*:RECONST_FREEWATER' {
        memory = { 20.GB * task.attempt }
    }
    withName: '.*:RECONST_NODDI' {
        memory = { 14.GB * task.attempt }
    }
    withName: '.*:RECONST_DTIMETRICS' {
        memory = { 12.GB * task.attempt }
    }
    withName: '.*:FW_CORRECTED_DTIMETRICS' {
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

executor {
    // Per Nextflow, so per batch (BATCH_SIZE sessions, about 10 tasks of a session at once at most):
    // at most MAX_UNPACKED x queueSize task jobs in the queue, well under Slurm's per-user limit
    // (MaxSubmitJobs, 950 on Rorqual, shared with every other job of the user)
    queueSize       = 50
    submitRateLimit = '10/1min'
}

// Images pulled on a login node by ./run.sh setup (compute nodes have no internet)
apptainer {
    cacheDir = "${System.getenv('SFT_ROOT')}/containers"
}
